# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres (matches docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vectorflow
POSTGRES_USER=vectorflow
POSTGRES_PASSWORD=vectorflow_dev_pw

# Google Gemini embeddings API
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Auth (Part 3): HS256 signing secret for session JWTs. Any random string;
# generate one with `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=change-me-to-a-random-value
